# Copy to .env and fill in what you have. Nothing is required — the agent
# runs end-to-end with no credentials (simulated links, deterministic
# fallback diagnosis). Blank or placeholder values are treated as unset.

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
ANTHROPIC_API_KEY=

# --- optional tuning (defaults shown) ------------------------------------
# RECOVERY_LLM_MODEL=claude-haiku-4-5   # cheapest capable; the LLM calls are tiny
# RAZORPAY_LIVE_LINK_BUDGET=8           # real link creations/run before simulation
# RECOVERY_LOG_JSON=false
# RECOVERY_CORS_ORIGINS=                # only if the SPA is hosted apart from the
#                                      # API, e.g. https://recover-ai.vercel.app
