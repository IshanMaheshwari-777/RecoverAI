# Copy to .env and fill in what you have. Nothing is required — the agent
# runs end-to-end with no credentials, degrading to labelled simulation
# and deterministic fallbacks. Placeholder values (anything with "xxxx",
# "<...>", "example") are treated as unset.

# Razorpay test-mode keys — Dashboard ▸ Settings ▸ API Keys ▸ Test Mode
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic API key — for ambiguous-decline diagnosis and message drafting
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# --- optional tuning -------------------------------------------------------
# RECOVERY_LLM_MODEL=claude-opus-5
# RAZORPAY_LIVE_LINK_BUDGET=8      # genuinely-live link creations per run
# RECOVERY_LOG_JSON=false
# RECOVERY_LOG_LEVEL=INFO
